<?xml version="1.0"?>
<model>
  <name>dam_structure</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Narayana Panda</name>
    <email>narayanapanda10@gmail.com</email>
  </author>
  <description>
    Static concrete gravity dam with reinforced downstream buttresses,
    spillway gates, crest deck, control building, and pipeline section for
    underwater AUV inspection. Built from lightweight primitive geometry (no
    external mesh/Fuel dependency) so the live demo does not depend on network
    access.
  </description>
</model>
