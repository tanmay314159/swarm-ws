<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="dam_structure">
    <static>true</static>

    <!-- ================================================================
         Main gravity-dam body

         The large collision box is deliberately retained.  The detail
         around it is mostly visual-only: this keeps the existing AUV path
         planning and collision behaviour stable while giving the camera a
         recognizable concrete dam instead of a floating wall.
         =============================================================== -->
    <link name="dam_wall">
      <pose>0 -30 -20 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="dam_wall_collision">
        <geometry>
          <box>
            <size>80 4 60</size>
          </box>
        </geometry>
      </collision>
      <visual name="dam_wall_visual">
        <geometry>
          <box>
            <size>80 4 60</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.5 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
              <normal_map>materials/textures/concrete_normal.png</normal_map>
              <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- Reinforced concrete ribs make the downstream face read as a dam and
         break up the very large flat wall.  They are visual-only details;
         the wall collision remains the authoritative structural collision. -->
    <link name="downstream_buttresses">
      <visual name="buttress_left_outer">
        <pose>-32 -26.1 -24 0 0 0</pose>
        <geometry><box><size>4.0 3.5 52</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="buttress_left_inner">
        <pose>-16 -26.1 -24 0 0 0</pose>
        <geometry><box><size>4.0 3.5 52</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="buttress_center">
        <pose>0 -26.1 -24 0 0 0</pose>
        <geometry><box><size>4.0 3.5 52</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="buttress_right_inner">
        <pose>16 -26.1 -24 0 0 0</pose>
        <geometry><box><size>4.0 3.5 52</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="buttress_right_outer">
        <pose>32 -26.1 -24 0 0 0</pose>
        <geometry><box><size>4.0 3.5 52</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>

      <!-- Short upper returns give the ribs a stepped, poured-concrete shape. -->
      <visual name="upper_return_left">
        <pose>-24 -26.1 5 0 0 0</pose>
        <geometry><box><size>12 3.5 10</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="upper_return_right">
        <pose>24 -26.1 5 0 0 0</pose>
        <geometry><box><size>12 3.5 10</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
    </link>

    <!-- Horizontal construction joints and darker panel seams add scale to
         the concrete face without needing a large decal or mesh asset. -->
    <link name="dam_face_joints">
      <visual name="joint_upper">
        <pose>0 -27.96 5.0 0 0 0</pose>
        <geometry><box><size>78 0.06 0.16</size></box></geometry>
        <material><ambient>0.16 0.18 0.17 1</ambient><diffuse>0.25 0.27 0.26 1</diffuse></material>
      </visual>
      <visual name="joint_middle">
        <pose>0 -27.96 -12.0 0 0 0</pose>
        <geometry><box><size>78 0.06 0.16</size></box></geometry>
        <material><ambient>0.16 0.18 0.17 1</ambient><diffuse>0.25 0.27 0.26 1</diffuse></material>
      </visual>
      <visual name="joint_lower">
        <pose>0 -27.96 -30.0 0 0 0</pose>
        <geometry><box><size>78 0.06 0.16</size></box></geometry>
        <material><ambient>0.16 0.18 0.17 1</ambient><diffuse>0.25 0.27 0.26 1</diffuse></material>
      </visual>
      <visual name="joint_left">
        <pose>-24 -27.95 -21 0 0 0</pose>
        <geometry><box><size>0.14 0.06 57</size></box></geometry>
        <material><ambient>0.16 0.18 0.17 1</ambient><diffuse>0.25 0.27 0.26 1</diffuse></material>
      </visual>
      <visual name="joint_right">
        <pose>24 -27.95 -21 0 0 0</pose>
        <geometry><box><size>0.14 0.06 57</size></box></geometry>
        <material><ambient>0.16 0.18 0.17 1</ambient><diffuse>0.25 0.27 0.26 1</diffuse></material>
      </visual>
    </link>

    <!-- Crest deck, upstream/downstream parapets, and a small control building
         create the unmistakable top profile of a concrete dam. -->
    <link name="dam_crest">
      <visual name="crest_cap">
        <pose>0 -30 10.9 0 0 0</pose>
        <geometry><box><size>84 8 1.8</size></box></geometry>
        <material>
          <ambient>0.58 0.58 0.54 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0.18 0.18 0.18 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="downstream_parapet">
        <pose>0 -26.5 12.35 0 0 0</pose>
        <geometry><box><size>82 0.55 2.2</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="crest_end_left">
        <pose>-41 -30 12.0 0 0 0</pose>
        <geometry><box><size>1.5 8 3.8</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="crest_end_right">
        <pose>41 -30 12.0 0 0 0</pose>
        <geometry><box><size>1.5 8 3.8</size></box></geometry>
        <material>
          <ambient>0.52 0.52 0.48 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
    </link>

    <!-- Four dark gate faces and their concrete piers suggest spillway bays.
         They are placed on the downstream face above the inspection zone. -->
    <link name="spillway_bays">
      <visual name="spillway_gate_left_outer">
        <pose>-24 -27.91 3.5 0 0 0</pose>
        <geometry><box><size>11.0 0.12 12.0</size></box></geometry>
        <material>
          <ambient>0.04 0.07 0.08 1</ambient><diffuse>0.10 0.16 0.18 1</diffuse>
          <specular>0.55 0.6 0.6 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="spillway_gate_left_inner">
        <pose>-8 -27.91 3.5 0 0 0</pose>
        <geometry><box><size>11.0 0.12 12.0</size></box></geometry>
        <material>
          <ambient>0.04 0.07 0.08 1</ambient><diffuse>0.10 0.16 0.18 1</diffuse>
          <specular>0.55 0.6 0.6 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="spillway_gate_right_inner">
        <pose>8 -27.91 3.5 0 0 0</pose>
        <geometry><box><size>11.0 0.12 12.0</size></box></geometry>
        <material>
          <ambient>0.04 0.07 0.08 1</ambient><diffuse>0.10 0.16 0.18 1</diffuse>
          <specular>0.55 0.6 0.6 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="spillway_gate_right_outer">
        <pose>24 -27.91 3.5 0 0 0</pose>
        <geometry><box><size>11.0 0.12 12.0</size></box></geometry>
        <material>
          <ambient>0.04 0.07 0.08 1</ambient><diffuse>0.10 0.16 0.18 1</diffuse>
          <specular>0.55 0.6 0.6 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
