      <visual name="spillway_sill">
        <pose>0 -27.75 -2.75 0 0 0</pose>
        <geometry><box><size>78 1.0 1.2</size></box></geometry>
        <material>
          <ambient>0.48 0.48 0.44 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
    </link>

    <!-- A low-poly control/power building makes the crest read as an active
         hydroelectric facility. The windows are intentionally dark and
         emissive-looking so they remain readable through underwater fog. -->
    <link name="crest_control_building">
      <visual name="control_room">
        <pose>-25 -30 15.0 0 0 0</pose>
        <geometry><box><size>16 8 6</size></box></geometry>
        <material>
          <ambient>0.48 0.48 0.45 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="control_room_roof">
        <pose>-25 -30 18.25 0 0 0</pose>
        <geometry><box><size>18 10 0.7</size></box></geometry>
        <material>
          <ambient>0.18 0.2 0.2 1</ambient><diffuse>0.3 0.34 0.34 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="control_window_left">
        <pose>-29.5 -25.94 15.3 0 0 0</pose>
        <geometry><box><size>3.0 0.10 1.5</size></box></geometry>
        <material><ambient>0.02 0.08 0.1 1</ambient><diffuse>0.04 0.18 0.22 1</diffuse><specular>0.7 0.8 0.8 1</specular></material>
      </visual>
      <visual name="control_window_right">
        <pose>-24.5 -25.94 15.3 0 0 0</pose>
        <geometry><box><size>3.0 0.10 1.5</size></box></geometry>
        <material><ambient>0.02 0.08 0.1 1</ambient><diffuse>0.04 0.18 0.22 1</diffuse><specular>0.7 0.8 0.8 1</specular></material>
      </visual>
      <visual name="control_window_far">
        <pose>-20.5 -25.94 15.3 0 0 0</pose>
        <geometry><box><size>3.0 0.10 1.5</size></box></geometry>
        <material><ambient>0.02 0.08 0.1 1</ambient><diffuse>0.04 0.18 0.22 1</diffuse><specular>0.7 0.8 0.8 1</specular></material>
      </visual>
    </link>

    <!-- Pipeline section running away from the dam face for the AUVs to
         inspect along its length, in addition to the wall face. -->
    <link name="pipe_section">
      <pose>15 -8 -40 -1.5708 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="pipe_collision">
        <geometry>
          <cylinder>
            <radius>2</radius>
            <length>40</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pipe_visual">
        <geometry>
          <cylinder>
            <radius>2</radius>
            <length>40</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.4 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
              <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
              <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
              <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- Heavy flange and dark intake mouth at the pipe's dam-side end. -->
    <link name="pipe_intake_details">
      <visual name="pipe_wall_flange">
        <pose>15 -28.35 -40 -1.5708 0 0</pose>
        <geometry><cylinder><radius>2.55</radius><length>0.65</length></cylinder></geometry>
        <material>
          <ambient>0.22 0.24 0.25 1</ambient><diffuse>0.7 0.72 0.7 1</diffuse>
          <specular>0.45 0.45 0.45 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/rusty_metal_albedo.png</albedo_map>
            <normal_map>materials/textures/rusty_metal_normal.png</normal_map>
            <roughness_map>materials/textures/rusty_metal_roughness.png</roughness_map>
            <metalness_map>materials/textures/rusty_metal_metalness.png</metalness_map>
          </metal></pbr>
        </material>
      </visual>
      <visual name="pipe_intake_mouth">
        <pose>15 -28.72 -40 -1.5708 0 0</pose>
        <geometry><cylinder><radius>1.95</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.015 0.025 0.03 1</ambient><diffuse>0.025 0.06 0.07 1</diffuse><specular>0.15 0.2 0.2 1</specular></material>
      </visual>
      <visual name="pipe_support_lower">
        <pose>15 -25.5 -42.8 0 0 0</pose>
        <geometry><box><size>5.0 2.0 1.0</size></box></geometry>
        <material>
          <ambient>0.45 0.45 0.42 1</ambient><diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
            <normal_map>materials/textures/concrete_normal.png</normal_map>
            <roughness_map>materials/textures/concrete_roughness.png</roughness_map>
          </metal></pbr>
